+/* Non-blocking check, used by the polling fallback of vk_kgsl_binary_wait_many. */
+static bool
+vk_kgsl_binary_is_signaled(struct tu_device *device,
+                           struct vk_kgsl_binary *binary)
+{
+   if (binary->type == VK_KGSL_SYNC_TYPE_FENCE) {
+      /* An imported sync file without an fd is already signaled. */
+      return binary->sync_file.fd < 0 ||
+             sync_wait(binary->sync_file.fd, 0) == 0;
+   }
+
+   struct kgsl_timeline_val timeline_val = {
+      .seqno = binary->binary_timeline.next_point,
+      .timeline = binary->binary_timeline.id,
+   };
+
+   return kgsl_timeline_wait_ioctl(device->physical_device->local_fd, 0,
+                                   &timeline_val, 1,
+                                   KGSL_TIMELINE_WAIT_ALL) == 0;
+}
