Every mesh draw dispatch was followed by WFI, CACHE_CLEAN, CACHE_INVALIDATE,
WFI and CP_WAIT_FOR_ME. Who consumes what:

- The CP reads the chunk arguments (CP_EXEC_CS_INDIRECT, the predicate
  register load, CP_DRAW_INDIRECT_MULTI) and, for task draws, the count it
  copies into the setup parameters. They are all written by the setup shader
  only, so only the setup dispatch needs CACHE_CLEAN + CP_WAIT_FOR_ME.
- Task shader -> setup shader, setup shader -> mesh/task shader and mesh
  shader -> vertex shader are shader to shader through UCHE. They need the
  dispatch to be finished (WFI), not a clean or an invalidate. The invalidate
  also threw away the table and records the next shaders read.
- CP writes -> shaders (tu_mesh_emit_cp_barrier) keep their invalidate.

NOT VERIFIED ON HARDWARE. If rendering corrupts or hangs with this applied,
revert this commit alone; the previous sequence is a superset. Not checked
against tu_flush_for_access() on the Mesa base 4da08cb.
---
 src/freedreno/vulkan/tu_cmd_buffer.cc | 20 ++++++++++++++++----
 1 file changed, 16 insertions(+), 4 deletions(-)

diff --git a/src/freedreno/vulkan/tu_cmd_buffer.cc b/src/freedreno/vulkan/tu_cmd_buffer.cc
index 1ce2543..e2ba44e 100644
--- a/src/freedreno/vulkan/tu_cmd_buffer.cc
+++ b/src/freedreno/vulkan/tu_cmd_buffer.cc
@@ -10209,15 +10209,27 @@ tu_mesh_chunk_args(const struct tu_cmd_buffer *cmd, uint32_t table,
                                chunk * TU_MESH_ARGS_SIZE);
 }
 
-/* Makes compute shader writes visible to later shaders and to the CP. */
+/* Orders a dispatch before the shaders reading what it wrote (the mesh and
+ * task shaders reading the table, the vertex shader reading the records).
+ * All of them access the data through UCHE, so no cache maintenance is needed.
+ */
 template <chip CHIP>
 static void
 tu_mesh_emit_shader_barrier(struct tu_cmd_buffer *cmd, struct tu_cs *cs)
 {
    tu_cs_emit_wfi(cs);
-   tu_emit_event_write<CHIP>(cmd, cs, FD_CACHE_CLEAN);
-   tu_emit_event_write<CHIP>(cmd, cs, FD_CACHE_INVALIDATE);
+}
+
+/* Makes the writes of the setup shader visible to the CP, which reads the
+ * chunk arguments (dispatch size, enable flag, draw arguments) from memory.
+ * The cleaned lines stay valid for the shaders reading the table afterwards.
+ */
+template <chip CHIP>
+static void
+tu_mesh_emit_cp_read_barrier(struct tu_cmd_buffer *cmd, struct tu_cs *cs)
+{
    tu_cs_emit_wfi(cs);
+   tu_emit_event_write<CHIP>(cmd, cs, FD_CACHE_CLEAN);
    tu_cs_emit_pkt7(cs, CP_WAIT_FOR_ME, 0);
 }
 
@@ -10405,7 +10417,7 @@ tu_mesh_emit_setup(struct tu_cmd_buffer *cmd, struct tu_cs *cs,
 
    tu_mesh_emit_program<CHIP>(cmd, cs, cmd->device->mesh_setup);
    tu_mesh_emit_dispatch<CHIP>(cmd, cs, cmd->device->mesh_setup, 0, 1, 0);
-   tu_mesh_emit_shader_barrier<CHIP>(cmd, cs);
+   tu_mesh_emit_cp_read_barrier<CHIP>(cmd, cs);
 }
 
