-         writes_pos = true;
-      } else {
+         nir_variable *var = nir_variable_clone(ms_var, vs);
+         var->type = glsl_get_array_element(ms_var->type);
+         if (var->data.per_primitive) {
+            var->data.per_primitive = false;
+            var->data.interpolation = INTERP_MODE_FLAT;
