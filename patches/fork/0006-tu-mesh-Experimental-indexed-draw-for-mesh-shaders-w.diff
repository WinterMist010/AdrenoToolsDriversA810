+                io->indexed ? "on" : "off (per-primitive outputs)");
+   }
+
    unsigned vertex_size = io->max_vertices * io->vertex_slots * 16;
    io->prim_offset = vertex_size;
+
+   if (io->indexed) {
+      io->vertex_shift = util_logbase2_ceil(io->max_vertices);
+      io->index_bytes = io->max_primitives * io->verts_per_prim * 4;
+      io->cull_offset = io->prim_offset;
+      io->stride = io->cull_offset + align(io->max_primitives * 4, 16);
+      /* The index region is rounded up to 16 bytes, leave room for that. */
