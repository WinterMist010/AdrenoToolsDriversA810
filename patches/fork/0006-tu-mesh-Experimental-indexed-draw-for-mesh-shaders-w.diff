diff --git a/src/freedreno/vulkan/tu_cmd_buffer.cc b/src/freedreno/vulkan/tu_cmd_buffer.cc
index e2ba44e..5db4ace 100644
--- a/src/freedreno/vulkan/tu_cmd_buffer.cc
+++ b/src/freedreno/vulkan/tu_cmd_buffer.cc
@@ -10420,6 +10420,19 @@ tu_mesh_emit_setup(struct tu_cmd_buffer *cmd, struct tu_cs *cs,
    tu_mesh_emit_cp_read_barrier<CHIP>(cmd, cs);
 }
 
+/* The draw initiator of an indexed draw with the 32 bit indices of the mesh
+ * ring, whatever index buffer the application bound.
+ */
+static uint32_t
+tu_mesh_indexed_initiator(struct tu_cmd_buffer *cmd)
+{
+   auto saved = cmd->state.index_size;
+   cmd->state.index_size = INDEX4_SIZE_32_BIT;
+   uint32_t initiator = tu_draw_initiator(cmd, DI_SRC_SEL_DMA);
+   cmd->state.index_size = saved;
+   return initiator;
+}
+
 /* Runs the mesh shader over one chunk of the mesh table and draws its
  * primitives.
  */
@@ -10430,13 +10443,49 @@ tu_mesh_emit_chunk(struct tu_cmd_buffer *cmd, struct tu_cs *cs,
                    uint32_t groups, uint64_t args)
 {
    tu_mesh_emit_dispatch<CHIP>(cmd, cs, ms, base, groups, args);
-   tu_mesh_emit_shader_barrier<CHIP>(cmd, cs);
+   if (ms->mesh.indexed) {
+      /* Not known to go through UCHE like the loads of the vertex shader: the
+       * hardware fetches the indices of the draw.
+       */
+      tu_mesh_emit_cp_read_barrier<CHIP>(cmd, cs);
+   } else {
+      tu_mesh_emit_shader_barrier<CHIP>(cmd, cs);
+   }
 
    /* The compute state overwrote part of the fragment shader state. */
    tu_cs_emit_pkt7(cs, CP_SET_DRAW_STATE, 3);
    tu_cs_emit_draw_state(cs, TU_DRAW_STATE_FS, cmd->state.program.fs_state);
 
-   if (args) {
+   if (ms->mesh.indexed) {
+      /* The indices of the chunk are one array at the start of the record
+       * region. The record layout and the sizes are the same as for the
+       * non-indexed draw: max_primitives * verts_per_prim indices a
+       * workgroup.
+       */
+      uint64_t index_va = tu_mesh_ring(cmd, TU_MESH_RECORD_OFFSET);
+      uint32_t indices_per_group =
+         ms->mesh.max_primitives * ms->mesh.verts_per_prim;
+
+      if (args) {
+         tu_cs_emit_pkt7(cs, CP_DRAW_INDIRECT_MULTI, 9);
+         tu_cs_emit(cs, tu_mesh_indexed_initiator(cmd));
+         tu_cs_emit(cs, A6XX_CP_DRAW_INDIRECT_MULTI_1_OPCODE(INDIRECT_OP_INDEXED) |
+                        A6XX_CP_DRAW_INDIRECT_MULTI_1_DST_OFF(vs_params_offset(cmd)));
+         tu_cs_emit(cs, 1);
+         tu_cs_emit_qw(cs, index_va);
+         tu_cs_emit(cs, ms->mesh.chunk_workgroups * indices_per_group);
+         tu_cs_emit_qw(cs, args + TU_MESH_ARG_DRAW);
+         tu_cs_emit(cs, 0);
+      } else {
+         tu_cs_emit_pkt7(cs, CP_DRAW_INDX_OFFSET, 7);
+         tu_cs_emit(cs, tu_mesh_indexed_initiator(cmd));
+         tu_cs_emit(cs, 1);
+         tu_cs_emit(cs, groups * indices_per_group);
+         tu_cs_emit(cs, 0);
+         tu_cs_emit_qw(cs, index_va);
+         tu_cs_emit(cs, groups * indices_per_group);
+      }
+   } else if (args) {
       tu_cs_emit_pkt7(cs, CP_DRAW_INDIRECT_MULTI, 6);
       tu_cs_emit(cs, tu_draw_initiator(cmd, DI_SRC_SEL_AUTO_INDEX));
       tu_cs_emit(cs, A6XX_CP_DRAW_INDIRECT_MULTI_1_OPCODE(INDIRECT_OP_NORMAL) |
